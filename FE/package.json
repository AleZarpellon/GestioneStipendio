{
  "main": "electron/main.js",
  "name": "fe",
  "version": "1.0.8",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron:dev": "concurrently \"ng serve\" \"wait-on http://localhost:4200 && electron .\"",
    "electron:build": "rimraf release && ng build --configuration production && electron-builder",
    "build:all": "git add . && git commit -m \"pre-release\" || echo ok && npm version patch -m \"release: %s\" && cd ../BE && mvn clean package -DskipTests && cd ../FE && npm install && npx tsc -p tsconfig.electron.json && npm run electron:build",
    "release:patch": "npm run build:all && git push origin main --follow-tags",
    "release:minor": "npm run build:all && git push origin main --follow-tags",
    "release:major": "npm run build:all && git push origin main --follow-tags"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "^21.2.4",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@primeng/themes": "^21.0.4",
    "@tailwindcss/postcss": "^4.2.1",
    "electron-updater": "^6.8.3",
    "postcss": "^8.5.8",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.3",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.2.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.0",
    "concurrently": "^9.2.1",
    "electron": "^41.0.3",
    "electron-builder": "^24.13.3",
    "jsdom": "^27.1.0",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.gestionestipendio.id",
    "productName": "GestioneStipendio",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "asar": true,
    "asarUnpack": [
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/uninstaller.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "AleZarpellon",
      "repo": "GestioneStipendio"
    }
  }
}
